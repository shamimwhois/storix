{
  "name": "storix-docs",
  "private": true,
  "version": "1.0.0",
  "description": "Build tooling for the Storix static documentation portal",
  "scripts": {
    "build": "npm run build:css && npm run build:js",
    "build:css": "@tailwindcss/cli -i ./src/css/app.css -o ./assets/app.css --minify",
    "build:js": "esbuild ./src/js/app.js --bundle --minify --format=iife --target=es2020 --outfile=./assets/app.js"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "alpinejs": "3.17.5",
    "esbuild": "0.25.12",
    "tailwindcss": "4.3.3"
  }
}
